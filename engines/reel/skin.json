{
  "codigo": "03-vsl",
  "nome": "VSL com interface animada",
  "familia": "interface-animada",
  "nativa": {
    "fontes": {
      "destaque": {"familia": "Anybody", "peso": 900, "estilo": "normal", "caixa": "alta", "largura": "expandida"},
      "texto":    {"familia": "Plus Jakarta Sans", "peso": 700, "estilo": "normal"},
      "tecnica":  {"familia": "JetBrains Mono", "peso": 500, "estilo": "normal", "fixa": true, "uso": "camcorder HUD and technical labels"}
    },
    "cores": {
      "fundo": "#1f123d",
      "texto": "#ffffff",
      "destaque": "#8b5cf6",
      "apoio": "#b9a3ff",
      "acento2": "#a59cc4"
    },
    "cores_extra": {
      "fundo_profundo": "#0e0b1e",
      "fundo_claro": "#2d1f50",
      "destaque_alt": "#9b63ff",
      "botao_gradiente": ["#8b55ff", "#a47fff"]
    },
    "grading": "natural",
    "grade_aprovada": {
      "filtro": "saturate(1.04) contrast(1.05) brightness(0.97)",
      "tinta1": 0.3,
      "tinta2": 0.25,
      "nota": "the approved 'soft' one; color stays in the graphics, not on the skin (R4)"
    },
    "clima": "escuro"
  },
  "slots": {
    "fontes": ["destaque", "texto"],
    "cores": ["fundo", "texto", "destaque", "apoio", "acento2"]
  },
  "invariantes": [
    "FULL (full screen with punch-in) alternates with SPLIT (content on top, presenter in a card below), always with an animated 0.45 s switch",
    "every spoken keyword gets an element that enters exactly on the word; every entry is anchored to the transcript and something new appears every 1.5–3 s",
    "true dark-glass interface with color in the graphic, not on the face: facts and logos from official sources or a declared illustration, face with natural color"
  ],
  "legenda": {"modo": "palavra", "posicao": "abaixo-do-queixo", "troca": "seca", "segue_a_boca": true, "some_em_split": true},
  "layouts": ["FULL", "SPLIT", "PIP", "TAKEOVER"],
  "proporcao_alvo": {"FULL": 0.40, "SPLIT": 0.45, "PIP": 0.08, "TAKEOVER": 0.07},
  "punch": {"base": 1.06, "impacto": [1.14, 1.20], "nota": "measure per video"},
  "sfx_por_segundo": [0.4, 0.85],
  "sfx_volume": 0.55,
  "sfx_modo": {"padrao": "enxuto", "opcoes": ["enxuto", "referencia"], "nota": "enxuto (lean) = R2 (≤ 0.8/s with typing; passes verify.py); referencia = the exact sound of the approved video (~1.4/s), via vsl.json"},
  "trilha": "nenhuma",
  "precisa": ["rosto", "prints-reais", "boca (track-mouth.py)"],
  "motor_embutido": {"modelo": "template/ (copy to <P>/motor and follow template/README.md)", "kit": "template/kit/ (untouched)", "exemplo": "template/example/ (approved reference, reassembles identical)"},
  "opcional": ["recorte-do-apresentador"]
}
